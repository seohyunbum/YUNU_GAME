      "short_script": [
        {
          "beat": "narration",
          "text_ko": "로드 카멜롯 — 전군 피해 무효!"
        }
      ]
    },
    {
      "id": "cs_excalibur",
      "title_ko": "엑스칼리버",
      "title_card": {
        "text": "EXCALIBUR"
      },
      "script": [
        {
          "beat": "line",
          "speaker_ref": "saber_artoria",
          "text_ko": "약속된 승리의 검 — "
        },
        {
          "beat": "title_card"
        },
        {
          "beat": "narration",
          "text_ko": "황금빛 섬광이 지평선을 지운다."
        }
      ],
      "short_script": [
        {
          "beat": "narration",
          "text_ko": "엑스칼리버!"
        }
      ]
    },
    {
